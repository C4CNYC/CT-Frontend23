{
  "name": "codetribe",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 8080",
    "dev:turbo": "next dev -p 8080 --turbo",
    "start": "next start",
    "build": "cp -r ./node_modules/tinymce ./public && next build",
    "build-and-start": "yarn build && yarn start",
    "analyze": "ANALYZE=true yarn build",
    "export": "yarn build && next export -o _static",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "clear": "rm -rf .next .swc _static node_modules",
    "postinstall": "patch-package && husky install",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "echo ”[Husky] pre-commit”"
    }
  },
